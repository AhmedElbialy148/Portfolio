# --- mis-nextjs-api-guards: server-only env ---
# Never expose these to the browser. Read them only in server code
# (route handlers, instrumentation, the guard adapters).

# Supabase (supabaseAuth adapter). The anon key is public by design; the
# session is verified server-side via getUser(), so it is safe here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Upstash Redis (upstashRateLimit + upstashIdempotency adapters).
# REST credentials — work on the Edge runtime and across serverless isolates.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
